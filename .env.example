# e-consultation — environment template
#
# PLACEHOLDERS ONLY. Never put a real credential in this file — it is committed to git.
# Copy to `.env` (gitignored) and fill in locally:  cp .env.example .env
#
# The credentials previously stored here (GMAIL_APP_PASSWORD, SUPABASE_SERVICE_ROLE_KEY)
# have been removed and MUST be rotated — see EC-PLAT-001 D-1. They are in use until then.

# ---------------------------------------------------------------------------
# Legacy — REMOVED at T4 per EC-CUTOVER-001 DEC-6. Listed so the T4 removal
# checklist is checkable. Do not add new consumers.
# ---------------------------------------------------------------------------
AUTH_SECRET=replace-me-openssl-rand-hex-32
NEXTAUTH_SECRET=replace-me-openssl-rand-hex-32
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
DB_PROVIDER=supabase
GMAIL_USER=replace-me@example.com
GMAIL_APP_PASSWORD=replace-me-rotated-credential

# ---------------------------------------------------------------------------
# Legacy Supabase direct access — REMOVED at T4. Still read by
# lib/supabase.ts, lib/repositories/factory.ts and the two api-endpoints.md
# §2.2 exceptions (app/api/bug-reports/**, POST /api/audit/forbidden), which
# stay local by design (EC-PLAT-001 CON-9).
# ---------------------------------------------------------------------------
SUPABASE_URL=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me-rotated-credential

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
SSO_FEATURE_FLAG=false
EMAIL_FEATURE_FLAG=true

# ---------------------------------------------------------------------------
# Target env contract (EC-PLAT-001 DEC-3) — effective once the BFF handler lands
# ---------------------------------------------------------------------------

# Public: URLs and tenant slug only. No secrets, ever (CON-2, CON-4).
NEXT_PUBLIC_AUTH_URL=https://auth.lyceumalabang.edu.ph
NEXT_PUBLIC_CONSULT_TENANT_SLUG=loa-consultation

# Server-only: read in Route Handlers / server code, never shipped to the browser.
# Unset on Vercel — the BFF falls back to the production hosts in code (DEC-3, CON-6).
CONSULT_API_URL=http://localhost:9002
AUTH_API_URL=http://localhost:8080

# NOTE: NEXT_PUBLIC_CONSULT_API_URL was removed 2026-09-30 (EC-PLAT-001 DEC-6).
# It was a public variable holding the Consult API host, which the BFF exists to
# prevent the browser from knowing. The browser base is a same-origin constant,
# not a variable — see EC-API-001 DEC-1/DEC-7.
